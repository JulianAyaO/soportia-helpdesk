POSTGRES_DB=soportia
POSTGRES_USER=soportia
POSTGRES_PASSWORD=soportia_local

N8N_DB=n8n
N8N_DB_USER=n8n
N8N_DB_PASSWORD=n8n_local

JWT_SECRET=local-development-secret-change-me-at-least-32-characters
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=14

N8N_ENCRYPTION_KEY=local-n8n-encryption-key-change-me
N8N_HMAC_SECRET=local-automation-hmac-secret-change-me
N8N_ROUTING_WEBHOOK_URL=http://n8n:5678/webhook/soportia-ticket-routing
N8N_SLA_WEBHOOK_URL=http://n8n:5678/webhook/soportia-sla-alerts
N8N_MAX_ATTEMPTS=8
N8N_PUBLISHER_DELAY_MS=5000
N8N_BLOCK_ENV_ACCESS_IN_NODE=false

SOPORTIA_SLA_WAIT_SECONDS=15
SOPORTIA_WAITING_HOURS=2

# Optional. Set to this machine LAN IP if the nginx TLS cert should include it.
TLS_IP=

# Host-run API (docker compose up postgres n8n, then mvnw spring-boot:run)
# DB_URL=jdbc:postgresql://localhost:5432/soportia
# DB_USER=soportia
# DB_PASSWORD=soportia_local
# ATTACHMENTS_DIR=./data/attachments
